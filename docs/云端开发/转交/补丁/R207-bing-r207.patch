@@ -0,0 +1,66 @@
+id: PLN-19
+name: 重要性重估
+workpaper: {ref: A-5, area: A}  # 底稿索引号与所属区 (需求 R329, knowledge/workpapers.yaml); 协调者 10-21 定在计划区
+# 规格书 6.1.2 (第 755, 812 行), 10 节 P3 (第 1425 行: 更正验证 → PLN-19 → FIN-04 → FIN-15); 设计稿 v2.1 第 2.8, 5.6,
+# 6.6 节; ASA 320 第 12, 13 段, ASA 450 第 10 段. 完成阶段按 "试算表加已验证更正分录" 重算三种基准与候选, 按未更正
+# 错报算调整后基准, 与计划的重要性比较, 结果 MaterialityReassessment (REASSESSMENT) 为 PLN-19 闸门的材料 (需求 R207;
+# 字段与未更正错报对基准的影响见接口文档第 2.4 节). 执行 (A4) 见 R208, 节点与闸门见 R209.
+# - M01 同 PLN-01 的 M01, 只把余额来源换成 adjusted_trial_balance(:eid, :verified_adjustment_entry_nos) (接口文档
+#   第 5 节 "更正后余额", 需求 R174); tests/test_knowledge.py 守住两边只差这一段.
+# - P01 例外不写 SQL, 由 A4 按 M01 的行与状态在代码中算 (同 CSH-02 D01 的写法): |change_pct| 达到 revise_threshold_pct
+#   时建 X-PLN-19-{run_no}-P01-1 (接口文档第 0 节), 比较口径见 R208.
+# - 闸门程序: 建议判断 J-PLN-19-{run_no}-MATERIALITY 不建复核任务, 判断失败时材料注明 AI 建议缺失 (接口文档第 5 节).
+scope:
+  zh: >-
+    {{ period_end }} 试算表加已验证的审计更正分录{% if verified_adjustment_entry_nos %} ({{ verified_adjustment_entry_nos | join(", ") }}) {% endif %}上的收入,
+    总资产与税前利润三种基准, 及未更正错报对它们的影响
+  en: >-
+    The revenue, total assets and profit before tax benchmarks on the {{ period_end }} trial balance with the verified
+    audit adjustments{% if verified_adjustment_entry_nos %} ({{ verified_adjustment_entry_nos | join(", ") }}){% endif %},
+    and the effect of uncorrected misstatements on them
+phase: P3_Completion
+cycle: Completion
+owner: A4
+feature: reassessment             # 功能开关 (services/features.py): 重要性重估, 需要 misstatement 与 planning (需求 R313)
+outputs: [materiality_reassessment, judgments, exceptions]
+# 本期试算表与更正分录 (adjusted_trial_balance 读这两张), 科目表 (M01 的类型与分类, 错报按科目映射到基准)
+reads: [accounts, trial_balance, journal_entries]
+engine: hybrid
+autonomy_level: L1
+gate: PLN-19
+params:
+  period_end: {ref: period_end}
+  materiality_cents: {ref: materiality_cents}
+  performance_materiality_cents: {ref: performance_materiality_cents}
+  clearly_trivial_cents: {ref: clearly_trivial_cents}
+  verified_adjustment_entry_nos: {ref: verified_adjustment_entry_nos}   # 已验证的审计更正分录凭证号 (需求 R174)
+  # 以下同 PLN-01
+  candidates:
+    - {basis: revenue, pct_low: 0.005, pct_high: 0.01}
+    - {basis: total_assets, pct_low: 0.01, pct_high: 0.02}
+    - {basis: profit_before_tax, pct_low: 0.05, pct_high: 0.05}
+  performance_pct_range: [0.5, 0.75]
+  clearly_trivial_pct: 0.05
+  revenue_categories: [revenue]          # 收入基准取这些标准分类的科目 (accounts.category)
+  income_tax_categories: [income_tax]    # 税前利润扣除的所得税分类
+  revise_threshold_pct: 0.10      # 调整后整体重要性较计划变动达到这一比例时建议修订: 实务惯例, 非准则规定
+# 每轮在更正验证 (FIN-09) 之后, FIN-04 之前执行 (节点 p3_reassess 与 PLN-19 闸门见 R209); 程序依赖只有计划的重要性
+depends_on: [PLN-01]
+standards: [ASA320-P12, ASA320-P13, ASA450-P10]
+evidence_required: [voucher]
+rules:
+  - id: M01
+    name: 更正后的重要性基准取数
+    severity: low
+    emit: rows
+    sql: |
+      WITH balances AS (SELECT t.balance_cents, a.code, a.type, COALESCE(a.category,'') AS category FROM adjusted_trial_balance(:eid, :verified_adjustment_entry_nos) t
+       JOIN accounts a ON a.engagement_id=:eid AND a.code=t.account_code)
+      SELECT 'revenue' AS basis, COALESCE(-SUM(balance_cents),0) AS base_amount_cents FROM balances WHERE category=ANY(:revenue_categories)
+      UNION ALL SELECT 'total_assets', COALESCE(SUM(balance_cents),0) FROM balances WHERE type='asset'
+      UNION ALL SELECT 'profit_before_tax', COALESCE(-SUM(balance_cents),0) FROM balances
+       WHERE type IN ('revenue','expense') AND category<>ALL(:income_tax_categories)
+      ORDER BY basis
+llm:
+  prompt: PLN-19.md.j2
+  output_model: ReassessmentDraft
