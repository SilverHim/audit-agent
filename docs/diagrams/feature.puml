rectangle "● F-TRAIL  Audit trail\n<size:15>M-07</size>" as F_TRAIL

rectangle "● F-AUTO  Autonomy level" as F_AUTO
rectangle "supported autonomy levels (all four are always present)\nthe effective level of a procedure instance is a run-time attribute, not a product choice (7.4)" as AUTOGRP #line.dashed {
  rectangle "L1  Advisory\n<size:15>AI proposes, human decides each</size>" as L1
  rectangle "L2  Judgment + review\n<size:15>human reviews each</size>" as L2
  rectangle "L3  Exception-based\n<size:15>human reviews exceptions only</size>" as L3
  rectangle "L4  Autonomous\n<size:15>post-hoc sampling</size>" as L4
}
rectangle "run-time constraints (not features)\n<size:15>gated procedure (F-GATE) => effective level = L1, never L4</size>\n<size:15>blind flag: set on L1 when cumulative downgrade hits the floor;</size>\n<size:15>evidence only, no AI suggestion (7.4)</size>" as F_BLINDFLAG #line.dashed

