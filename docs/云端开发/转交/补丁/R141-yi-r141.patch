+def decided(gen03: Gen03, overrides: Mapping[str, str] | None = None) -> EngagementState:
+    """GEN-03 两条任务都经审计师决定之后的状态: overrides 中的节点 (节点 ID → 新结论) 为 override, 其余为 confirm;
+    决定的效果 (判断新版本, 人工判断, 例外归因) 并入状态."""
+    state = gen03.state
+    for task in gen03.patch["review_tasks"]:
+        target = next(j for j in state["judgments"] if j.id == task.target_id)
+        current = {x.id: x for x in state["exceptions"]}
+        explained = [current[i] for i in target.exception_ids]
+        conclusion = (overrides or {}).get(target.subject_id)
+        if conclusion is None:
+            effects = confirm_effects(target, explained)
+        else:
+            record = ReviewRecord(
+                id=f"D-{task.id}",
+                task_id=task.id,
+                target_version=target.version,
+                decision=Decision.override,
+                reason="审计师改写结论",
+                override_conclusion=conclusion,
+                reviewed_by="U-1",
+                decided_at=NOW,
+            )
+            effects = override_effects(record, task, target, explained, {j.id for j in state["judgments"]})
+        patch = {
+            "judgments": [e for e in effects if isinstance(e, Judgment)],
+            "exceptions": [e for e in effects if isinstance(e, AuditException)],
+        }
+        state = apply_patch(state, patch)  # type: ignore[arg-type]
+    return state
