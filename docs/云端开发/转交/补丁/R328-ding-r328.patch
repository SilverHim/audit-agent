+    """Agent 出错或片段校验不过时照常抛出 (节点错误, 由 runner 记入 run_error), 不写执行记录与例外."""
+    deps = scanning_deps(exceptions)
+    with pytest.raises(error):
+        await GraphNodes(deps, 2).scan_increment(node_state(deps), xero_engagement(), GEN05, FIRST)
