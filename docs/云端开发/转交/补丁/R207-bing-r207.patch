+        "bases": bases,
+        "uncorrected_misstatement_ids": [],
+        "unmapped_misstatement_ids": [],
+        "current_overall_cents": 32431,
+        "adjusted_overall_cents": 32431,
+        "change_pct": 0.0,
+        "revise_threshold_pct": 0.1,
+        "materiality_dependent_procedures": [
