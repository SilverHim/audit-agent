+    REV-02; 建议判断 J-PLN-19-{run_no}-MATERIALITY. changes 覆盖任意字段 (经 model_validate)."""
+    figures = [  # 基准, 金额, 比例区间, 候选区间 (分), 本期不适用的原因
+        ("revenue", 3243100, 0.005, 0.01, 16216, 32431, None),
+        ("total_assets", 1092882, 0.01, 0.02, 10929, 21858, None),
+        ("profit_before_tax", -1317843, 0.05, 0.05, -65892, -65892, "loss"),
+    ]
+    candidates = [
+        MaterialityCandidate(
+            basis=basis,  # type: ignore[arg-type]
+            base_amount_cents=amount,
+            pct_low=pct_low,
+            pct_high=pct_high,
+            low_cents=low,
+            high_cents=high,
+            not_applicable=reason,  # type: ignore[arg-type]
+        )
+        for basis, amount, pct_low, pct_high, low, high, reason in figures
+    ]
+    bases = [
+        BasisAdjustment(basis=basis, recorded_base_cents=amount, uncorrected_effect_cents=0, adjusted_base_cents=amount)  # type: ignore[arg-type]
+        for basis, amount, *_ in figures
+    ]
+    base = {
+        "id": "REASSESSMENT",
+        "version": version,
+        "run_id": run_id,
+        "planning_choice": MaterialityChoice(basis="revenue", pct=0.01, performance_pct=0.5, clearly_trivial_pct=0.05),
+        "planning_decision_id": "D-PLN",
+        "planning_materiality_cents": 32431,
+        "planning_performance_cents": 16216,
+        "planning_trivial_cents": 1622,
+        "verified_adjustment_entry_nos": ["AJE-X01", "AJE-X05"],
+        "candidates": candidates,
+        "performance_pct_range": (0.5, 0.75),
