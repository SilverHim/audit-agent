+    for lib in (base, misstatement):
+        assert not lib.enabled("PLN-19") and "PLN-19" not in {p.id for p in fixed_procedures(lib)}
+    assert on.enabled("PLN-19") and "PLN-19" in {p.id for p in fixed_procedures(on)}
+    assert [lib.load("FIN-04").depends_on for lib in (base, misstatement, on)] == [
