+    candidates: list[MaterialityCandidate]   # 按调整后试算表重算的三个候选；以下两项同 PLN-01 参数
+    performance_pct_range: tuple[float, float]
+    clearly_trivial_pct: float
+    bases: list[BasisAdjustment]             # 三个基准，与 candidates 的基准相同且各一项，含原选择的基准（模型校验）
+    uncorrected_misstatement_ids: list[str]  # 参与调整的错报（uncorrected、partially_corrected）
+    unmapped_misstatement_ids: list[str]     # 其中科目映射不到的，不参与调整
+    current_overall_cents: int               # 原选择 × 所选基准的 recorded_base_cents
+    adjusted_overall_cents: int              # 原选择 × 所选基准的 adjusted_base_cents
+    change_pct: float                        # (adjusted_overall - planning_materiality) / planning_materiality，四位小数，ROUND_HALF_UP
+    revise_threshold_pct: float              # 建议修订的门槛（参数 0.10，实务惯例，非准则规定）
