+def delivery_records(notes: Sequence[DeliveryNote]) -> list[dict[str, Any]] | None:
+    """一张发票的服务完成记录数组 (REV-08 R01, R02 与 GEN-05 R12 的总体 SQL 同写法, jsonb_agg 按记录 ID): 每条
