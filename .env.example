# 复制为 .env 后填写. 键名见 开发接口文档.md 第 11 节.
DATABASE_URL=postgresql://audit_app:audit_app@localhost:5432/audit
DATABASE_OWNER_URL=postgresql://audit_owner:audit_owner@localhost:5432/audit
CHECKPOINT_BACKEND=postgres

EVIDENCE_ROOT=./var/engagements
DATASET_ROOT=./data
# 新建项目时默认选的数据集; Numbat 为 demo, 仍可在下拉中选
DEMO_DATASET=xero/20261017-q1
KNOWLEDGE_ROOT=./src/backend/knowledge

LLM_MODE=mock
# mock 模式的 fixture 目录: Numbat 等非 Xero 数据集读这里; Xero 数据集 (xero/<快照>) 读补造目录的 llm/
# (data/xero_demo/<快照>/llm, 由 data/generate_xero_demo.py 从 tests/fixtures/llm_xero 复制), 没有时也读这里
LLM_FIXTURES_ROOT=./data/demo/llm
# live 模式: OpenAI 兼容接口. LLM_BASE_URL 缺省为 OpenAI; DeepSeek 填 https://api.deepseek.com/v1, 本地 Ollama 填 http://localhost:11434/v1
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
PARALLEL_CAP=4
# 启用的功能, 逗号分隔 (登记表见 src/backend/services/features.py); 缺省只有基线功能 critic, 留空全部关闭
FEATURES=critic
# 审计助理对话: 一轮最多调几次带工具的模型, 历史的估算 token 上限 (超过即压缩), 一轮工具结果的 token 预算,
# 压缩时保留原文的最近轮数, 单个工具结果最多字符数
CONCIERGE_MAX_STEPS=6
CONCIERGE_CONTEXT_BUDGET=24000
CONCIERGE_TURN_RESERVE=8000
CONCIERGE_KEEP_TURNS=4
CONCIERGE_TOOL_RESULT_CHARS=6000
# 设置页保存的模型密钥用它加密, 只放 .env. 生成: uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SETTINGS_SECRET_KEY=

# Xero 接入 (可选): 填应用的 Client ID (Web app 另填 secret) 后运行 uv run python -m backend.adapters.xero login 授权
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
XERO_REDIRECT_URI=http://localhost:8765/callback
XERO_TENANT_ID=
# 付费接口 live | mock (网页导出模拟) | off (不取)
XERO_PAID_ENDPOINTS=off

JWT_SECRET=change-me
JWT_EXPIRE_MINUTES=480
SEED_USER_EMAIL=rca@example.com
SEED_USER_PASSWORD=change-me
FRONTEND_ORIGIN=http://localhost:5173
