+def test_a4_may_write_reassessment_but_not_review_tasks() -> None:
+    """R207 验收 8: A4 执行 PLN-19 的片段 (重估材料 REASSESSMENT, 建议判断与 P01 例外, outputs 取 PLN-19.yaml) 通过;
+    再带复核任务被拒 (闸门程序的判断不建任务, A4 的写入范围不含 review_tasks); 重估材料引用的例外在片段与状态中都没有
+    时被拒 (EXCEPTION_REFERRERS), 原因含例外 ID."""
+    pln19 = make_run("PLN-19")
+    p01 = exception("X-PLN-19-1-P01-1", "PLN-19", pln19.id)
+    advice = judgment("J-PLN-19-1-MATERIALITY", "PLN-19", pln19.id, [p01.id]).model_copy(
+        update={"subject_id": "MATERIALITY"}
+    )
+    patch: StatePatch = {
+        "materiality_reassessment": materiality_reassessment(pln19.id, exception_ids=[p01.id]),
+        "judgments": [advice],
+        "exceptions": [p01],
+        "procedure_runs": [finished(pln19)],
+    }
+    state = make_state(procedure_pack=[*PACK, make_procedure("PLN-19", Phase.P3_Completion)])
+    check = {"writer": AgentId.A4, "procedure_id": "PLN-19", "run_id": pln19.id, "state": state}
+    assert declared("PLN-19") == ["materiality_reassessment", "judgments", "exceptions"]
+    check_patch(patch, **check, outputs=declared("PLN-19"))  # type: ignore[arg-type]
+    with pytest.raises(MergeRejected, match="merge_rejected: A4 不能写字段 review_tasks"):
+        check_patch(
+            {**patch, "review_tasks": [task(advice.id, run_id=pln19.id)]},
+            **check,  # type: ignore[arg-type]
+            outputs=[*declared("PLN-19"), "review_tasks"],
+        )
+    with pytest.raises(MergeRejected) as info:
+        check_patch({**patch, "judgments": [], "exceptions": []}, **check, outputs=declared("PLN-19"))  # type: ignore[arg-type]
+    assert info.value.reasons == ["MaterialityReassessment REASSESSMENT 引用的例外 X-PLN-19-1-P01-1 不存在"]
