+def context_problems(value: dict[str, Any], jctx: JudgmentContext, standards: list[str]) -> list[str]:
+    """fixture 中引了上下文以外来源的指针: 允许的为关系图各关系的证据所指的摘录页 (文件与页都须相同), 本项目画像的
+    顶层字段, 以及模板 standards 的片段. 防 fixture 引到没有关系指向的页或别的画像而照样通过."""
+    allowed: dict[str, set[Any]] = {
+        "document": {(x["evidence"]["source_id"], x["evidence"]["page"]) for x in jctx.data["graph"]["links"]},
+        "client_profile": {(jctx.subject_id, field) for field in type(xero_profile()).model_fields},
+        "standard": set(standards),
+    }
+    problems = []
+    for p in [*value["evidence"], *(q for s in value["reasoning_chain"] for q in s["evidence"])]:
+        key: Any = p["source_id"]
+        if p["source_type"] == "document":
+            key = (p["source_id"], p.get("page"))
+        elif p["source_type"] == "client_profile":
+            key = (p["source_id"], p.get("locator"))
+        if key not in allowed.get(p["source_type"], set()):
+            problems.append(f"{p['source_type']} {p['source_id']} {p.get('locator')} 不在上下文中")
+    return sorted(set(problems))
