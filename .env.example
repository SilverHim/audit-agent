# 复制为 .env 后填写. 键名见 开发接口文档.md 第 11 节.
DATABASE_URL=postgresql://audit_app:audit_app@localhost:5432/audit
DATABASE_OWNER_URL=postgresql://audit_owner:audit_owner@localhost:5432/audit
CHECKPOINT_BACKEND=postgres

EVIDENCE_ROOT=./var/engagements
DATASET_ROOT=./data
KNOWLEDGE_ROOT=./src/backend/knowledge

LLM_MODE=mock
# live 模式: OpenAI 兼容接口. LLM_BASE_URL 缺省为 OpenAI; DeepSeek 填 https://api.deepseek.com/v1, 本地 Ollama 填 http://localhost:11434/v1
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
PARALLEL_CAP=4

JWT_SECRET=change-me
JWT_EXPIRE_MINUTES=480
SEED_USER_EMAIL=rca@example.com
SEED_USER_PASSWORD=change-me
FRONTEND_ORIGIN=http://localhost:5173
