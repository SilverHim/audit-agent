+def test_pln19_prompt_renders_with_its_header_variables() -> None:
+    """验收 9: 头注释是 R208 的数据契约: 列出的变量 (subject_id, task, data 的 reassessment, misstatements,
+    adjustment_lines, trial_balance, rule_findings, standards) 恰为模板用到的顶层变量; 按它们渲染通过 (StrictUndefined),
+    计划的选择与三项金额, 调整前后的整体重要性与变动, 重估材料, 错报, 更正分录行, 试算表, 规则例外与片段正文都进了
+    提示词; 末尾有输出语言一节. 口径: 修订以门槛为准, 两个方向都算, 建议的选择须合候选的规则, 降低时点名引用重要性的
+    程序; 建议动作只有 accept 与 more_evidence. 缺任一顶层变量即抛 UndefinedError."""
+    source = (ROOT / "prompts" / "PLN-19.md.j2").read_text(encoding="utf-8")
+    header = source.split("#}", 1)[0]
+    listed = re.findall(r"^  (\w+)[.\s]", header, re.MULTILINE)
+    assert listed == PLN19_VARIABLES
+    assert meta.find_undeclared_variables(Environment().parse(source)) == set(PLN19_VARIABLES)
+    for field in ("reassessment", "misstatements", "adjustment_lines", "trial_balance"):
+        assert re.search(rf"^  data\.{field}\s", header, re.MULTILINE), field
+    variables = pln19_variables()
+    template = prompt_env(ROOT / "prompts").get_template("PLN-19.md.j2")
+    text = template.render(variables)
+    assert "Materiality at planning (decision D-PLN): benchmark revenue, 0.01 of the benchmark" in text
+    assert "amounts (cents) 32431, 16216 and 1622" in text
+    assert "32431 on the adjusted trial balance, 32431 after the effect" in text
+    assert "Change from planning: 0.0 (revision threshold 0.1)" in text
+    for fragment in ('"id": "REASSESSMENT"', '"id": "M-D-CSH02-091"', '"id": "AJE-X05-2"', '"account_code": "200"'):
+        assert fragment in text, fragment
+    assert '"id": "X-PLN-19-1-P01-1"' in text and "\n## Output language\n" in text
+    criteria = text.split("## Criteria", 1)[1].split("## proposed_action", 1)[0]
+    for phrase in (
+        "reaches the revision threshold in either direction",
+        "A change below the threshold alone is not a reason to revise",
+        "a benchmark whose base amount is positive",
+        "materiality_dependent_procedures",
+        "unmapped",
+    ):
+        assert phrase in criteria, phrase
+    actions = text.split("## proposed_action", 1)[1].split("## Output", 1)[0]
+    accept, more = (line for line in actions.splitlines() if line.startswith("- `"))
+    assert accept.startswith("- `accept`: materiality remains appropriate; `revise` is false")
+    assert more.startswith("- `more_evidence`: a revision is suggested (`revise` is true)")
+    for f in variables["standards"]:
+        assert f"- {f['id']} ({f['standard']} para {f['paragraph']}): {f['text'].strip()}" in text, f["id"]
+    for missing in set(PLN19_VARIABLES):
+        with pytest.raises(UndefinedError):
+            template.render({k: v for k, v in variables.items() if k != missing})
+
