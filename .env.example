# 复制为 .env 后填写. 键名见 开发接口文档.md 第 11 节.
DATABASE_URL=postgresql://audit_app:audit_app@localhost:5432/audit
DATABASE_OWNER_URL=postgresql://audit_owner:audit_owner@localhost:5432/audit
CHECKPOINT_BACKEND=postgres

EVIDENCE_ROOT=./var/engagements
DATASET_ROOT=./data
# 新建项目时默认选的数据集; Numbat 为 demo, 仍可在下拉中选
DEMO_DATASET=xero/20261017-q1
KNOWLEDGE_ROOT=./src/backend/knowledge

LLM_MODE=mock
# mock 模式的 fixture 目录: Numbat 等非 Xero 数据集读这里; Xero 数据集 (xero/<快照>) 读补造目录的 llm/
# (data/xero_demo/<快照>/llm, 由 data/generate_xero_demo.py 从 tests/fixtures/llm_xero 复制), 没有时也读这里
LLM_FIXTURES_ROOT=./data/demo/llm
# live 模式: OpenAI 兼容接口. LLM_BASE_URL 缺省为 OpenAI; DeepSeek 填 https://api.deepseek.com/v1, 本地 Ollama 填 http://localhost:11434/v1
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
PARALLEL_CAP=4
# 启用的功能, 逗号分隔 (登记表见 src/backend/services/features.py); 代码缺省只有基线功能 critic, 留空全部关闭.
# 演示打开智能体协作 collab (需求 R155: A7 触发规则补齐, 争议中, 仲裁补全, 判断呈递, 停留时长), 分录测试 journals
# (需求 R146: GEN-05 全量分录扫描, GEN-02 分录例外归因), 总体审计计划 planning (需求 R317: 程序装配后起草计划,
# 审计师批准后才进入执行阶段) 与错报闭环 misstatement (需求 R195: 错报分类, 与管理层沟通, 等更正, 更正验证); 项目
# 启动时冻结
FEATURES=critic,collab,journals,misstatement,planning,more_evidence
# 审计助理对话: 一轮最多调几次带工具的模型, 历史的估算 token 上限 (超过即压缩), 一轮工具结果的 token 预算,
# 压缩时保留原文的最近轮数, 单个工具结果最多字符数
CONCIERGE_MAX_STEPS=6
CONCIERGE_CONTEXT_BUDGET=24000
CONCIERGE_TURN_RESERVE=8000
CONCIERGE_KEEP_TURNS=4
CONCIERGE_TOOL_RESULT_CHARS=6000
# 设置页保存的模型密钥用它加密, 只放 .env. 生成: uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SETTINGS_SECRET_KEY=

# Xero 接入 (可选): 填应用的 Client ID (Web app 另填 secret, secret 只放 .env). 网页在数据管理页连接 (回调到后端
# XERO_REDIRECT_URI, 加密存库, 要配 SETTINGS_SECRET_KEY); 命令行 uv run python -m backend.adapters.xero login 回调到
# XERO_CLI_REDIRECT_URI, 令牌存 var/xero/token.json. 两个回调地址都要在 Xero 应用里登记
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
XERO_REDIRECT_URI=http://localhost:8000/api/v1/integrations/xero/callback
XERO_CLI_REDIRECT_URI=http://localhost:8765/callback
XERO_TENANT_ID=
# 付费接口 live | mock (网页导出模拟) | off (不取)
XERO_PAID_ENDPOINTS=off

# ABN 实时核查 (可选): 在 https://abr.business.gov.au/Tools/WebServices 读使用限制与用户指南, 接受 Web Services
# Agreement 后注册, ABR 用邮件发 GUID; 只放 .env. 为空时新客户的 ABN 核查转人工确认
ABN_LOOKUP_GUID=

JWT_SECRET=change-me
JWT_EXPIRE_MINUTES=480
SEED_USER_EMAIL=rca@example.com
SEED_USER_PASSWORD=change-me
FRONTEND_ORIGIN=http://localhost:5173
# Xero 授权回调后跳回的前端地址, 为空时取 FRONTEND_ORIGIN
FRONTEND_URL=
